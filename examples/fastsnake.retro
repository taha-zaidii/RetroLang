// fastsnake.retro — high-speed snake on a small wraparound board.
// Demonstrates wrap_edges = true and AMBER theme.

game "FastSnake"
    grid 15 x 15
    block_size 32
    background #1a0f00
    theme AMBER

snake_mode
    start_length 4
    food_count   3
    wrap_edges   true
    speed        90ms

rules
    score_per_food 25
    game_over      on_self_collision

controls
    move_up    KEY_W
    move_down  KEY_S
    move_left  KEY_A
    move_right KEY_D
    pause      KEY_SPACE
    restart    KEY_R
    quit       KEY_Q
